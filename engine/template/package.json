    "react-dom": "19.1.0",
    "remotion": "4.0.538",
    "simple-icons": "16.35.0",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.1.2",
    "@react-three/postprocessing": "3.0.4",
    "@remotion/motion-blur": "4.0.538",
    "@remotion/noise": "4.0.538",
    "@remotion/three": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "@types/three": "^0.176.0",
    "postprocessing": "6.37.3",
    "three": "^0.176.0",
    "three-stdlib": "^2.36.1"
