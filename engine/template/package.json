{
  "name": "reel-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Word-synced explainer reels (Remotion). Driven by src/timeline.json from build_timeline.py.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Reel out/reel.mp4 --codec h264 --crf 18",
    "typecheck": "tsc --noEmit"
