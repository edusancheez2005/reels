[
 {
  "speaker": "narrator",
  "text": "A stranger is about to send you the first bitcoin transfer.",
  "startMs": 80,
  "endMs": 3780
 },
 {
  "speaker": "narrator",
  "text": "Ten coins.",
  "startMs": 4005,
  "endMs": 4855
 },
 {
  "speaker": "narrator",
  "text": "January 2009.",
  "startMs": 5080,
  "endMs": 6690
 },
 {
  "speaker": "narrator",
  "text": "You've never met him.",
  "startMs": 6915,
  "endMs": 8125
 },
 {
  "speaker": "narrator",
  "text": "Nobody has.",
  "startMs": 8350,
  "endMs": 9350
 },
 {
  "speaker": "narrator",
  "text": "He calls himself Satoshi Nakamoto.",
  "startMs": 9575,
  "endMs": 11785
 },
 {
  "speaker": "narrator",
  "text": "He's posted bitcoin to a mailing list of cryptographers.",
  "startMs": 12010,
  "endMs": 15360
 },
 {
  "speaker": "narrator",
  "text": "The list replies.",
  "startMs": 15585,
  "endMs": 16775
 },
 {
  "speaker": "stonks",
  "text": "Unsubscribe.",
  "startMs": 17000,
  "endMs": 17820
 },
 {
  "speaker": "narrator",
  "text": "You download his software.",
  "startMs": 18045,
  "endMs": 19425
 },
 {
  "speaker": "narrator",
  "text": "He sends you ten bitcoin.",
  "startMs": 19650,
  "endMs": 21170
 },
 {
  "speaker": "narrator",
  "text": "As a test.",
  "startMs": 21395,
  "endMs": 22225
 },
 {
  "speaker": "suit",
  "text": "Received.",
  "startMs": 22450,
  "endMs": 23410
 },
 {
  "speaker": "narrator",
  "text": "That's the hug.",
  "startMs": 24435,
  "endMs": 25295
 },
 {
  "speaker": "narrator",
  "text": "You report bugs.",
  "startMs": 25520,
  "endMs": 26620
 },
 {
  "speaker": "narrator",
  "text": "He fixes them.",
  "startMs": 26845,
  "endMs": 27845
 },
 {
  "speaker": "narrator",
  "text": "The closest partnership in bitcoin.",
  "startMs": 28070,
  "endMs": 30060
 },
 {
  "speaker": "narrator",
  "text": "You never learn his real name.",
  "startMs": 30285,
  "endMs": 31975
 },
 {
  "speaker": "narrator",
  "text": "Your computer also mines, which makes new coins.",
  "startMs": 32200,
  "endMs": 35250
 },
 {
  "speaker": "narrator",
  "text": "But it runs hot, and the fan's loud.",
  "startMs": 35475,
  "endMs": 37535
 },
 {
  "speaker": "narrator",
  "text": "You switch it off.",
  "startMs": 37760,
  "endMs": 38810
 },
 {
  "speaker": "suit",
  "text": "Much better.",
  "startMs": 39735,
  "endMs": 40815
 },
 {
  "speaker": "narrator",
  "text": "This was real: Satoshi Nakamoto and Hal Finney, January twelfth, 2009.",
  "startMs": 41440,
  "endMs": 46970
 },
 {
  "speaker": "narrator",
  "text": "Hal later wrote he wished he'd kept mining.",
  "startMs": 47195,
  "endMs": 49335
 },
 {
  "speaker": "narrator",
  "text": "And that he was extraordinarily lucky to be there.",
  "startMs": 49560,
  "endMs": 52030
 },
 {
  "speaker": "narrator",
  "text": "Even bitcoin's inventor sent a test.",
  "startMs": 52255,
  "endMs": 54445
 },
 {
  "speaker": "narrator",
  "text": "Sending somewhere new?",
  "startMs": 54670,
  "endMs": 55900
 },
 {
  "speaker": "narrator",
  "text": "Send a small amount first.",
  "startMs": 56155,
  "endMs": 57695
 }
]