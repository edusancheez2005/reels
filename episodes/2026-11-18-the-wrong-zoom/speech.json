[
 {
  "speaker": "narrator",
  "text": "It's March 2020.",
  "startMs": 80,
  "endMs": 1750
 },
 {
  "speaker": "narrator",
  "text": "You're locked indoors, and you have a plan.",
  "startMs": 1975,
  "endMs": 4175
 },
 {
  "speaker": "narrator",
  "text": "The whole planet is on Zoom.",
  "startMs": 4400,
  "endMs": 6040
 },
 {
  "speaker": "narrator",
  "text": "So you're buying a piece of Zoom.",
  "startMs": 6265,
  "endMs": 7855
 },
 {
  "speaker": "narrator",
  "text": "Your friend double-checked.",
  "startMs": 8080,
  "endMs": 9470
 },
 {
  "speaker": "stonks",
  "text": "Says Zoom.",
  "startMs": 9695,
  "endMs": 10385
 },
 {
  "speaker": "narrator",
  "text": "You type Z, O, O, M.",
  "startMs": 10610,
  "endMs": 12070
 },
 {
  "speaker": "narrator",
  "text": "You tap the first result.",
  "startMs": 12295,
  "endMs": 13785
 },
 {
  "speaker": "narrator",
  "text": "It's already gone from about three dollars to over twenty in a month.",
  "startMs": 14010,
  "endMs": 17830
 },
 {
  "speaker": "narrator",
  "text": "You start pricing boats.",
  "startMs": 18055,
  "endMs": 19455
 },
 {
  "speaker": "narrator",
  "text": "Used ones.",
  "startMs": 19680,
  "endMs": 20580
 },
 {
  "speaker": "narrator",
  "text": "Let's not get carried away.",
  "startMs": 20805,
  "endMs": 22265
 },
 {
  "speaker": "narrator",
  "text": "The video company's stock code is Z, M.",
  "startMs": 23690,
  "endMs": 26230
 },
 {
  "speaker": "narrator",
  "text": "You own Zoom Technologies.",
  "startMs": 26455,
  "endMs": 28145
 },
 {
  "speaker": "narrator",
  "text": "Silent since 2015.",
  "startMs": 28370,
  "endMs": 30280
 },
 {
  "speaker": "suit",
  "text": "Bollocks.",
  "startMs": 30505,
  "endMs": 31225
 },
 {
  "speaker": "narrator",
  "text": "Off by two letters.",
  "startMs": 31450,
  "endMs": 32630
 },
 {
  "speaker": "narrator",
  "text": "By then, the wrong fucking Zoom was rising faster than the real one.",
  "startMs": 32855,
  "endMs": 36885
 },
 {
  "speaker": "narrator",
  "text": "The regulator froze it for two weeks, worried people were mixing them up.",
  "startMs": 37110,
  "endMs": 41200
 },
 {
  "speaker": "narrator",
  "text": "Nobody could sell.",
  "startMs": 41425,
  "endMs": 42535
 },
 {
  "speaker": "narrator",
  "text": "This happened in March 2020.",
  "startMs": 42760,
  "endMs": 45000
 },
 {
  "speaker": "narrator",
  "text": "And in 2019.",
  "startMs": 45225,
  "endMs": 46825
 },
 {
  "speaker": "narrator",
  "text": "Same four letters.",
  "startMs": 47050,
  "endMs": 48220
 },
 {
  "speaker": "narrator",
  "text": "Read the whole name.",
  "startMs": 48445,
  "endMs": 49585
 },
 {
  "speaker": "stonks",
  "text": "Boat's coming Tuesday.",
  "startMs": 49810,
  "endMs": 50970
 }
]