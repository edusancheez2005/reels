[
 {
  "speaker": "narrator",
  "text": "In April 2020, oil gets so cheap they pay people to take it.",
  "startMs": 80,
  "endMs": 4840
 },
 {
  "speaker": "narrator",
  "text": "You buy yours the Friday before.",
  "startMs": 5065,
  "endMs": 7035
 },
 {
  "speaker": "narrator",
  "text": "Nobody's driving.",
  "startMs": 7260,
  "endMs": 8440
 },
 {
  "speaker": "narrator",
  "text": "Oil's eighteen dollars a barrel.",
  "startMs": 8665,
  "endMs": 10445
 },
 {
  "speaker": "narrator",
  "text": "You buy a thousand.",
  "startMs": 10670,
  "endMs": 11830
 },
 {
  "speaker": "narrator",
  "text": "Before breakfast.",
  "startMs": 12055,
  "endMs": 13095
 },
 {
  "speaker": "stonks",
  "text": "Cars need it.",
  "startMs": 13320,
  "endMs": 14200
 },
 {
  "speaker": "narrator",
  "text": "Monday the twentieth, it's falling.",
  "startMs": 14425,
  "endMs": 16245
 },
 {
  "speaker": "narrator",
  "text": "A thousand more.",
  "startMs": 16470,
  "endMs": 17540
 },
 {
  "speaker": "narrator",
  "text": "Just after two, it hits zero.",
  "startMs": 17765,
  "endMs": 19635
 },
 {
  "speaker": "stonks",
  "text": "Free oil!",
  "startMs": 19860,
  "endMs": 20510
 },
 {
  "speaker": "narrator",
  "text": "You take a thousand free ones.",
  "startMs": 20735,
  "endMs": 22555
 },
 {
  "speaker": "narrator",
  "text": "Twenty minutes later: minus forty.",
  "startMs": 22780,
  "endMs": 24940
 },
 {
  "speaker": "suit",
  "text": "They pay me?",
  "startMs": 25165,
  "endMs": 26195
 },
 {
  "speaker": "narrator",
  "text": "No.",
  "startMs": 27450,
  "endMs": 27950
 },
 {
  "speaker": "narrator",
  "text": "You pay.",
  "startMs": 28175,
  "endMs": 28835
 },
 {
  "speaker": "narrator",
  "text": "You promised to collect real oil, from one Oklahoma town.",
  "startMs": 29060,
  "endMs": 32960
 },
 {
  "speaker": "narrator",
  "text": "Its tanks are nearly full.",
  "startMs": 33185,
  "endMs": 34635
 },
 {
  "speaker": "narrator",
  "text": "Tomorrow, you're locked in.",
  "startMs": 34860,
  "endMs": 36300
 },
 {
  "speaker": "narrator",
  "text": "So people pay to escape.",
  "startMs": 36525,
  "endMs": 38065
 },
 {
  "speaker": "narrator",
  "text": "The day ends at minus thirty-seven dollars sixty-three.",
  "startMs": 38290,
  "endMs": 41380
 },
 {
  "speaker": "narrator",
  "text": "First time below zero.",
  "startMs": 41605,
  "endMs": 43135
 },
 {
  "speaker": "narrator",
  "text": "In real life, you'd get a bill.",
  "startMs": 43360,
  "endMs": 44990
 },
 {
  "speaker": "narrator",
  "text": "This is a cartoon.",
  "startMs": 45215,
  "endMs": 46465
 },
 {
  "speaker": "narrator",
  "text": "Here's the lorry.",
  "startMs": 46690,
  "endMs": 47660
 },
 {
  "speaker": "stonks",
  "text": "I signed.",
  "startMs": 49385,
  "endMs": 50025
 },
 {
  "speaker": "narrator",
  "text": "Three thousand barrels.",
  "startMs": 50250,
  "endMs": 51590
 },
 {
  "speaker": "narrator",
  "text": "One-bed flat.",
  "startMs": 51815,
  "endMs": 52785
 },
 {
  "speaker": "narrator",
  "text": "Never a bet.",
  "startMs": 53010,
  "endMs": 53870
 },
 {
  "speaker": "narrator",
  "text": "It was oil, with a delivery date.",
  "startMs": 54095,
  "endMs": 56065
 },
 {
  "speaker": "stonks",
  "text": "More outside.",
  "startMs": 56290,
  "endMs": 57070
 },
 {
  "speaker": "suit",
  "text": "Fuck off.",
  "startMs": 57295,
  "endMs": 58155
 }
