[
 {
  "speaker": "narrator",
  "text": "You have the only job where the boss cuts your pay in half every four years, and everybody claps.",
  "startMs": 80,
  "endMs": 5890
 },
 {
  "speaker": "narrator",
  "text": "You mine bitcoin.",
  "startMs": 6115,
  "endMs": 7215
 },
 {
  "speaker": "narrator",
  "text": "In 2009, every block of payments you seal pays fifty brand-new coins.",
  "startMs": 7440,
  "endMs": 12550
 },
 {
  "speaker": "narrator",
  "text": "In 2012, the boss walks in.",
  "startMs": 12775,
  "endMs": 15235
 },
 {
  "speaker": "stonks",
  "text": "Twenty-five!",
  "startMs": 15460,
  "endMs": 16210
 },
 {
  "speaker": "narrator",
  "text": "You clap too.",
  "startMs": 16435,
  "endMs": 17355
 },
 {
  "speaker": "narrator",
  "text": "2016, twelve and a half.",
  "startMs": 17580,
  "endMs": 19890
 },
 {
  "speaker": "narrator",
  "text": "You sell the coffee machine.",
  "startMs": 20115,
  "endMs": 21645
 },
 {
  "speaker": "narrator",
  "text": "2020, six and a quarter.",
  "startMs": 21870,
  "endMs": 24150
 },
 {
  "speaker": "narrator",
  "text": "You sell your chair.",
  "startMs": 24375,
  "endMs": 25435
 },
 {
  "speaker": "narrator",
  "text": "2024, three point one two five.",
  "startMs": 25660,
  "endMs": 28900
 },
 {
  "speaker": "suit",
  "text": "Standing desk.",
  "startMs": 29125,
  "endMs": 30315
 },
 {
  "speaker": "narrator",
  "text": "Your boss has never been prouder.",
  "startMs": 30540,
  "endMs": 32430
 },
 {
  "speaker": "narrator",
  "text": "One problem.",
  "startMs": 34655,
  "endMs": 35595
 },
 {
  "speaker": "narrator",
  "text": "There is no boss.",
  "startMs": 35820,
  "endMs": 36930
 },
 {
  "speaker": "narrator",
  "text": "Bitcoin's code halves the new coins every four years or so, until they stop.",
  "startMs": 37155,
  "endMs": 41905
 },
 {
  "speaker": "narrator",
  "text": "So only twenty-one million will ever exist.",
  "startMs": 42130,
  "endMs": 44740
 },
 {
  "speaker": "narrator",
  "text": "Your not-boss is still clapping.",
  "startMs": 44965,
  "endMs": 46765
 },
 {
  "speaker": "stonks",
  "text": "Again!",
  "startMs": 46990,
  "endMs": 47520
 },
 {
  "speaker": "narrator",
  "text": "The cuts are real: the last was April 2024, the next around 2028.",
  "startMs": 47745,
  "endMs": 54395
 },
 {
  "speaker": "narrator",
  "text": "Nobody decides it.",
  "startMs": 54620,
  "endMs": 55840
 },
 {
  "speaker": "narrator",
  "text": "Everyone sees it coming.",
  "startMs": 56065,
  "endMs": 57465
 }
]