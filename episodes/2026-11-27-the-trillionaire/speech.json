[
 {
  "speaker": "narrator",
  "text": "You have a hundred trillion dollars in your wallet, and it barely covers the bus fare.",
  "startMs": 80,
  "endMs": 4720
 },
 {
  "speaker": "narrator",
  "text": "Zimbabwe, January 2009.",
  "startMs": 4945,
  "endMs": 7415
 },
 {
  "speaker": "narrator",
  "text": "One banknote, fourteen zeros.",
  "startMs": 7640,
  "endMs": 9620
 },
 {
  "speaker": "stonks",
  "text": "One, two...",
  "startMs": 9845,
  "endMs": 10605
 },
 {
  "speaker": "narrator",
  "text": "You are the richest person on this bus.",
  "startMs": 10830,
  "endMs": 12880
 },
 {
  "speaker": "narrator",
  "text": "So is everyone else.",
  "startMs": 13105,
  "endMs": 14465
 },
 {
  "speaker": "narrator",
  "text": "What your fortune buys.",
  "startMs": 14690,
  "endMs": 16060
 },
 {
  "speaker": "narrator",
  "text": "Day one: about thirty American dollars' worth.",
  "startMs": 16285,
  "endMs": 19075
 },
 {
  "speaker": "narrator",
  "text": "Soon: one bus fare.",
  "startMs": 19300,
  "endMs": 20620
 },
 {
  "speaker": "suit",
  "text": "Anything smaller?",
  "startMs": 20845,
  "endMs": 22195
 },
 {
  "speaker": "narrator",
  "text": "The next note down is fifty trillion.",
  "startMs": 22450,
  "endMs": 24560
 },
 {
  "speaker": "narrator",
  "text": "How does that happen?",
  "startMs": 25185,
  "endMs": 26305
 },
 {
  "speaker": "narrator",
  "text": "The central bank kept printing money.",
  "startMs": 26560,
  "endMs": 28510
 },
 {
  "speaker": "narrator",
  "text": "More notes, same bread.",
  "startMs": 28735,
  "endMs": 30005
 },
 {
  "speaker": "narrator",
  "text": "Prices rose, so it printed bigger notes.",
  "startMs": 30230,
  "endMs": 32730
 },
 {
  "speaker": "narrator",
  "text": "Two months earlier, at the worst point, prices doubled about every day.",
  "startMs": 32955,
  "endMs": 37025
 },
 {
  "speaker": "narrator",
  "text": "One economist's estimate.",
  "startMs": 37250,
  "endMs": 38780
 },
 {
  "speaker": "stonks",
  "text": "Where was I?",
  "startMs": 39005,
  "endMs": 39675
 },
 {
  "speaker": "narrator",
  "text": "April 2009.",
  "startMs": 39930,
  "endMs": 41350
 },
 {
  "speaker": "narrator",
  "text": "Zimbabwe stops using its own dollar.",
  "startMs": 41575,
  "endMs": 43775
 },
 {
  "speaker": "narrator",
  "text": "In the shops, your fortune buys: nothing.",
  "startMs": 44000,
  "endMs": 46350
 },
 {
  "speaker": "narrator",
  "text": "Six years on, the central bank will swap your note.",
  "startMs": 46575,
  "endMs": 49575
 },
 {
  "speaker": "narrator",
  "text": "For forty American cents.",
  "startMs": 49800,
  "endMs": 51380
 },
 {
  "speaker": "narrator",
  "text": "That year, on eBay, collectors paid up to thirty-five dollars for one.",
  "startMs": 52205,
  "endMs": 56645
 },
 {
  "speaker": "stonks",
  "text": "Fourteen!",
  "startMs": 56870,
  "endMs": 57500
 },
 {
  "speaker": "narrator",
  "text": "Don't count the zeros.",
  "startMs": 58225,
  "endMs": 59555
 },
 {
  "speaker": "narrator",
  "text": "Count what they buy.",
  "startMs": 59780,
  "endMs": 60880
 }
]