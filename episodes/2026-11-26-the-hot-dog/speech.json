[
 {
  "speaker": "narrator",
  "text": "You pay a dollar fifty for a Costco hot dog and drink.",
  "startMs": 80,
  "endMs": 3180
 },
 {
  "speaker": "narrator",
  "text": "You've paid that since 1985.",
  "startMs": 3405,
  "endMs": 5855
 },
 {
  "speaker": "narrator",
  "text": "America's longest-running sitcom.",
  "startMs": 6080,
  "endMs": 8110
 },
 {
  "speaker": "narrator",
  "text": "Season one.",
  "startMs": 8335,
  "endMs": 9175
 },
 {
  "speaker": "narrator",
  "text": "Your phone lives in the kitchen.",
  "startMs": 9400,
  "endMs": 11150
 },
 {
  "speaker": "stonks",
  "text": "The usual.",
  "startMs": 11375,
  "endMs": 12085
 },
 {
  "speaker": "narrator",
  "text": "Season fifteen.",
  "startMs": 12310,
  "endMs": 13390
 },
 {
  "speaker": "narrator",
  "text": "Your phone flips.",
  "startMs": 13615,
  "endMs": 14705
 },
 {
  "speaker": "narrator",
  "text": "Your hair leaves.",
  "startMs": 14930,
  "endMs": 15950
 },
 {
  "speaker": "narrator",
  "text": "The sign stays.",
  "startMs": 16175,
  "endMs": 17205
 },
 {
  "speaker": "narrator",
  "text": "Plot twist.",
  "startMs": 17930,
  "endMs": 18800
 },
 {
  "speaker": "narrator",
  "text": "An executive tells the co-founder: we're losing money.",
  "startMs": 19025,
  "endMs": 22195
 },
 {
  "speaker": "narrator",
  "text": "Raise the price?",
  "startMs": 22420,
  "endMs": 23460
 },
 {
  "speaker": "narrator",
  "text": "The answer, as the executive tells it: I will kill you.",
  "startMs": 23715,
  "endMs": 27045
 },
 {
  "speaker": "suit",
  "text": "Figure it out.",
  "startMs": 27270,
  "endMs": 28350
 },
 {
  "speaker": "narrator",
  "text": "Costco's fix: its own hot dog factory.",
  "startMs": 28575,
  "endMs": 31565
 },
 {
  "speaker": "narrator",
  "text": "Season forty-one.",
  "startMs": 31790,
  "endMs": 32960
 },
 {
  "speaker": "narrator",
  "text": "Costco sold over two hundred and forty-five million of these that year.",
  "startMs": 33185,
  "endMs": 37455
 },
 {
  "speaker": "narrator",
  "text": "Mostly to your friend.",
  "startMs": 37680,
  "endMs": 38950
 },
 {
  "speaker": "stonks",
  "text": "I had help.",
  "startMs": 39175,
  "endMs": 39795
 },
 {
  "speaker": "narrator",
  "text": "Since 1985, American prices roughly tripled.",
  "startMs": 40520,
  "endMs": 44490
 },
 {
  "speaker": "narrator",
  "text": "If the hot dog had kept up, it would cost about four dollars seventy.",
  "startMs": 44715,
  "endMs": 48905
 },
 {
  "speaker": "narrator",
  "text": "The price didn't move.",
  "startMs": 49130,
  "endMs": 50420
 },
 {
  "speaker": "narrator",
  "text": "Your dollar shrank.",
  "startMs": 50645,
  "endMs": 51725
 },
 {
  "speaker": "narrator",
  "text": "Costco's boss says it's staying.",
  "startMs": 51950,
  "endMs": 53710
 },
 {
  "speaker": "narrator",
  "text": "Renewed.",
  "startMs": 53935,
  "endMs": 54645
 },
 {
  "speaker": "narrator",
  "text": "When a price stands still, it's the money that moved.",
  "startMs": 55470,
  "endMs": 58450
 }
]